<?xml version="1.0" encoding="UTF-8" ?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN" "http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.offercat.ai.dao.StudentAnswerRecordMapper">
    <resultMap id="BaseResultMap" type="com.offercat.ai.entity.StudentAnswerRecord">
        <id column="record_id" property="recordId"/>
        <result column="student_id" property="studentId"/>
        <result column="question_id" property="questionId"/>
        <result column="user_answer" property="userAnswer"/>
        <result column="ai_score" property="aiScore"/>
        <result column="ai_feedback" property="aiFeedback"/>
        <result column="answer_time" property="answerTime"/>
    </resultMap>

    <select id="findByStudentId" resultMap="BaseResultMap">
        SELECT * FROM student_answer_record WHERE student_id = #{studentId}
    </select>

    <select id="findByStudentAndQuestion" resultMap="BaseResultMap">
        SELECT * FROM student_answer_record
        WHERE student_id = #{studentId} AND question_id = #{questionId}
    </select>

    <select id="findById" resultMap="BaseResultMap">
        SELECT * FROM student_answer_record WHERE record_id = #{recordId}
    </select>

    <insert id="insert" parameterType="com.offercat.ai.entity.StudentAnswerRecord" useGeneratedKeys="true" keyProperty="recordId">
        INSERT INTO student_answer_record (student_id, question_id, user_answer, ai_score, ai_feedback, answer_time)
        VALUES (#{studentId}, #{questionId}, #{userAnswer}, #{aiScore}, #{aiFeedback}, NOW())
    </insert>

    <update id="update" parameterType="com.offercat.ai.entity.StudentAnswerRecord">
        UPDATE student_answer_record SET
            user_answer = #{userAnswer},
            ai_score = #{aiScore},
            ai_feedback = #{aiFeedback}
        WHERE record_id = #{recordId}
    </update>

    <delete id="deleteById">
        DELETE FROM student_answer_record WHERE record_id = #{recordId}
    </delete>
</mapper>