# 复制为 application-dypns.yml 后填入真实密钥（勿提交仓库）
# 放置位置（任选其一，与 user 服务 application.yml 中 spring.config.import 一致）：
#   - user 服务启动目录下的 ./secrets/application-dypns.yml
#   - user 服务启动目录下的 ./config/application-dypns.yml
#   - 生产机 D:/offercat/config/application-dypns.yml（见 deploy/config/application-prod.yml）
#
# 也可使用环境变量（优先级相同，由 Spring 占位符解析）：
#   ALIBABA_CLOUD_ACCESS_KEY_ID
#   ALIBABA_CLOUD_ACCESS_KEY_SECRET

aliyun:
  dypns:
    access-key-id: "你的AccessKeyId"
    access-key-secret: "你的AccessKeySecret"
    region-id: cn-hangzhou
    # 与阿里云控制台「号码认证 → 短信认证」方案名称一致
    scheme-name: offercat
    country-code: "86"
    # 与控制台审核通过的签名、模板 CODE 一致
    sign-name: "速通互联验证码"
    template-code: "100001"
    template-param: '{"code":"##code##","min":"5"}'
    code-length: 6
    valid-time-seconds: 300
    send-interval-seconds: 60
    # 阿里云调用失败时回退 Redis（需 Redis 已启动；生产可按需关闭）
    redis-fallback-on-aliyun-failure: true
