/* pages/comment/comment.wxss */
page {
  background-color: rgb(249, 242, 228); /* 统一的护眼浅暖黄背景 */
  --header-text-color: #333;
}

.container-comment {
  display: flex;
  flex-direction: column;
  height: 100vh;
  position: relative;
}

/* Header */
.header {
  position: relative;
  overflow: hidden;
  z-index: 100;
  flex-shrink: 0;
}

.header-bg {
  display: none;
}

.header-content {
  position: relative;
  z-index: 2;
  background-color: rgb(245, 230, 160); /* 设置黄色背景 */
  height: 100%;
  display: flex;
  flex-direction: column;
  box-sizing: border-box;
  box-shadow: 0 4rpx 12rpx rgba(0,0,0,0.05); /* 轻微阴影 */
}

.header-top {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 0 20rpx;
}

.back-btn {
  font-size: 50rpx;
  color: var(--header-text-color);
  padding: 10rpx;
  line-height: 1;
  width: 60rpx;
  height: 60rpx;
  display: flex;
  align-items: center;
  justify-content: center;
}

.header-info {
  flex: 1;
  margin-left: 10rpx;
  display: flex;
  flex-direction: column;
  justify-content: center;
}

.header-title-row {
  display: flex;
  align-items: center;
}

.header-title {
  font-size: 34rpx;
  font-weight: bold;
  color: var(--header-text-color);
  letter-spacing: 1rpx;
}

.header-subtitle {
  font-size: 22rpx;
  color: #666;
  margin-top: 4rpx;
}

/* Search Bar */
.search-bar-container {
  padding: 16rpx 32rpx;
  background-color: #fff;
  flex-shrink: 0;
}

.search-bar {
  display: flex;
  align-items: center;
  background-color: #f5f5f5;
  border-radius: 36rpx;
  padding: 12rpx 24rpx;
  height: 72rpx;
  box-sizing: border-box;
}

.search-icon {
  margin-right: 16rpx;
}

.search-input {
  flex: 1;
  font-size: 28rpx;
  color: #333;
}

.search-placeholder {
  color: #999;
}

/* Tabs */
.tabs-scroll {
  width: 100%;
  height: 80rpx;
  background-color: #fff; /* 改为白色背景 */
  white-space: nowrap;
  flex-shrink: 0;
  padding-bottom: 10rpx;
}

.tabs-container {
  display: flex;
  padding: 0 20rpx;
  height: 100%;
  align-items: center;
}

.tab-item {
  position: relative;
  padding: 0 30rpx;
  font-size: 28rpx;
  color: #666;
  height: 100%;
  display: flex;
  align-items: center;
  justify-content: center;
  flex-shrink: 0;
  transition: all 0.3s;
}

.tab-item.active {
  color: #333;
  font-weight: bold;
  font-size: 32rpx;
}

.tab-indicator {
  position: absolute;
  bottom: 10rpx;
  left: 50%;
  transform: translateX(-50%);
  width: 40rpx;
  height: 8rpx;
  background-color: #333; /* 深色指示器 */
  border-radius: 4rpx;
}

/* Notice Bar */
.notice-bar {
  margin: 24rpx 32rpx;
  background: #fff;
  border-radius: 40rpx;
  padding: 0 24rpx;
  height: 80rpx;
  display: flex;
  align-items: center;
  box-shadow: 0 2rpx 8rpx rgba(0,0,0,0.02);
  border: 1px solid #e0e0e0;
  flex-shrink: 0;
}

.notice-tag {
  font-size: 22rpx;
  color: #ff9800;
  border: 1rpx solid #ff9800;
  padding: 2rpx 10rpx;
  border-radius: 8rpx;
  margin-right: 15rpx;
  font-weight: bold;
}

.notice-text {
  flex: 1;
  font-size: 26rpx;
  color: #666;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}

/* Post List */
.post-list {
  flex: 1;
  height: 0; /* 确保 scroll-view 在 flex 布局中正确计算高度 */
  /* background-color: rgb(249, 242, 228); 由page背景控制 */
  padding: 24rpx 32rpx 40rpx 32rpx; /* 增加顶部padding */
  box-sizing: border-box;
}

.post-item {
  background: #fff;
  border-radius: 24rpx;
  box-shadow: 0 4rpx 16rpx rgba(0,0,0,0.04);
  margin-bottom: 24rpx; /* 增加卡片间距 */
  padding: 32rpx;
  border: 1px solid rgba(0,0,0,0.02);
}

.user-info {
  display: flex;
  align-items: center;
  margin-bottom: 24rpx;
}

.avatar-wrapper {
  position: relative;
  width: 60rpx;
  height: 60rpx;
  margin-right: 20rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  flex-shrink: 0;
}

.user-avatar {
  width: 100%;
  height: 100%;
  border-radius: 50%;
  background-color: #eee;
  display: block;
}

.user-avatar-frame {
  position: absolute;
  top: 50%;
  left: 50%;
  width: 100%;
  height: 100%;
  transform: translate(-50%, -50%);
  z-index: 5;
  pointer-events: none;
}

.user-meta {
  flex: 1;
  display: flex;
  flex-direction: column;
}

.name-row {
  display: flex;
  align-items: center;
}

.private-badge {
  font-size: 20rpx;
  color: #fff;
  background: #bbb;
  padding: 2rpx 10rpx;
  border-radius: 6rpx;
  margin-left: 10rpx;
  font-weight: normal;
}

.rank-image {
  width: 32rpx;
  height: 32rpx;
  margin-left: 8rpx;
}

.user-name {
  font-size: 30rpx;
  font-weight: bold;
  color: #333;
  margin-bottom: 4rpx; /* 名字和时间的间距 */
}

.post-time {
  font-size: 24rpx;
  color: #999;
}

.post-more {
  color: #ccc;
  font-weight: bold;
  padding: 10rpx;
}

.post-content {
  margin-bottom: 24rpx;
}

.content-text {
  font-size: 30rpx;
  color: #333;
  line-height: 1.6;
  white-space: pre-wrap;
  word-break: break-all;
  display: block; /* 确保是块级元素 */
  margin-bottom: 24rpx; /* 增加底部间距，与图片隔开 */
  min-height: 40rpx; /* 确保至少有一行高度 */
}

.expand-btn {
  color: #576b95;
  font-size: 30rpx;
  margin-left: 8rpx;
  font-weight: bold;
  display: inline; /* 改为 inline 确保不换行 */
}

.content-collapsed {
  max-height: 150rpx; /* 约3行 */
  overflow: hidden;
  position: relative;
  /* 简单的淡出效果，虽然 rich-text 内部可能遮挡 */
  mask-image: linear-gradient(to bottom, black 60%, transparent 100%);
  -webkit-mask-image: linear-gradient(to bottom, black 60%, transparent 100%);
}

.image-list {
  display: flex;
  flex-wrap: wrap;
  width: 100%;
  clear: both; /* 清除浮动，防止被上文挤压 */
  margin-top: 10rpx; /* 再次确保有间距 */
}

.image-item {
  position: relative;
  margin-bottom: 10rpx;
  box-sizing: border-box;
}

/* 1张图：按比例显示 */
.single-mode .image-item {
  width: 60%; /* 固定宽度占比 */
  display: flex;
}

.single-mode .image-item image {
  width: 100%;      /* 宽度跟随容器 */
  height: auto;     /* 高度自动 */
  border-radius: 12rpx;
  /* mode="widthFix" 由 WXML 控制 */
}

/* 2张或3张及以上：3列模式 */
.grid-3 {
  width: 100%;
}

.grid-3 .image-item {
  width: calc((100% - 20rpx) / 3);
  height: 0;
  padding-bottom: calc((100% - 20rpx) / 3); /* 正方形 */
  margin-right: 10rpx;
  border-radius: 8rpx;
  overflow: hidden;
  position: relative; /* 确保遮罩层定位正确 */
}

.grid-3 .image-item:nth-child(3n) {
  margin-right: 0;
}

.grid-3 .image-item image {
  position: absolute;
  top: 0;
  left: 0;
  width: 100%;
  height: 100%;
  background-color: #f5f5f5;
}

/* 更多图片遮罩层（右下角角标） */
.more-count-mask {
  position: absolute;
  right: 0;
  bottom: 0;
  padding: 6rpx 14rpx;
  background-color: rgba(0, 0, 0, 0.5);
  border-top-left-radius: 12rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  z-index: 10;
}

.more-count-mask text {
  color: #fff;
  font-size: 28rpx;
  font-weight: bold;
}

/* Deprecated single image class, keeping for safety or specific use */
.content-image {
  width: 100%;
  margin-top: 20rpx;
  border-radius: 16rpx;
  background-color: #f5f5f5;
  box-shadow: 0 2rpx 8rpx rgba(0,0,0,0.05);
}

.post-footer {
  display: flex;
  align-items: center;
  justify-content: space-between;
  margin-top: 24rpx;
  padding-top: 20rpx;
  border-top: 1rpx solid #f9f9f9;
}

.view-count {
  font-size: 24rpx;
  color: #999;
  background-color: #f5f5f5;
  padding: 4rpx 12rpx;
  border-radius: 8rpx;
}

.action-icons {
  display: flex;
  align-items: center;
}

.icon-btn {
  margin-left: 40rpx;
  /* width: 56rpx; 删除固定宽度，避免文字挤压图标 */
  height: 56rpx;
  display: flex;
  align-items: center;
  justify-content: center;
}

.icon-btn image {
  width: 56rpx;
  height: 56rpx;
  transition: transform 0.2s cubic-bezier(0.175, 0.885, 0.32, 1.275);
  filter: brightness(0) opacity(0.5); /* 统一图标颜色为深灰色 */
}

.icon-btn image.like-active {
  filter: none; /* 点赞后的红色爱心保持原样 */
  opacity: 1;
}

.icon-btn image.collect-active {
  filter: drop-shadow(0 0 4rpx rgba(255, 152, 0, 0.5));
  opacity: 1;
  animation: starBounce 0.4s ease-in-out;
}

.like-active {
  animation: heartBeat 0.4s ease-in-out;
}

.like-count-tag {
  font-size: 22rpx;
  color: #ff4d4f;
  background-color: #fff0f0;
  padding: 4rpx 10rpx;
  border-radius: 12rpx;
  margin-right: 8rpx;
  font-weight: bold;
  line-height: 1;
}

@keyframes heartBeat {
  0% { transform: scale(1); }
  50% { transform: scale(1.3); }
  100% { transform: scale(1); }
}

@keyframes starBounce {
  0% { transform: scale(1); }
  50% { transform: scale(1.4); }
  100% { transform: scale(1); }
}

/* 点赞列表样式 */
.likes-wrapper {
  margin-top: 24rpx;
  background-color: #fffaf0; /* 浅黄色背景，呼应主题 */
  padding: 16rpx 24rpx;
  border-radius: 12rpx;
  display: flex;
  align-items: flex-start;
}

.likes-content {
  display: flex;
  flex-wrap: wrap;
  align-items: center;
  font-size: 26rpx;
  color: #333;
  line-height: 1.5;
}

.likes-icon-small {
  width: 32rpx;
  height: 32rpx;
  margin-right: 12rpx;
  margin-top: 2rpx;
}

.like-names {
  font-weight: bold;
}

.like-name {
  color: #576b95;
  font-weight: 500;
}

.like-count {
  font-weight: bold;
  color: #576b95;
}

.like-text-suffix {
  color: #333;
  margin-left: 8rpx;
}

/* 评论列表样式 */
.comments-wrapper {
  margin-top: 0;
  padding: 10rpx 0 0 0;
  border-top: none;
}

.comment-item {
  display: flex;
  margin-top: 24rpx;
  padding-bottom: 0;
  border-bottom: none;
}

.comment-item:last-child {
  border-bottom: none;
  margin-bottom: 0;
  padding-bottom: 0;
}

.comment-avatar {
  width: 64rpx;
  height: 64rpx;
  border-radius: 50%;
  margin-right: 20rpx;
  background-color: #eee;
  flex-shrink: 0;
}

.comment-content-box {
  flex: 1;
  background-color: #f9f9f9;
  padding: 16rpx 24rpx;
  border-radius: 16rpx;
  border-top-left-radius: 4rpx; /* 对话气泡效果 */
}

.comment-header {
  display: flex;
  justify-content: space-between;
  align-items: center;
  margin-bottom: 6rpx;
}

.comment-nickname {
  font-size: 26rpx;
  color: #666;
  font-weight: bold;
}

.comment-time {
  font-size: 20rpx;
  color: #bbb;
}

.comment-text {
  font-size: 28rpx;
  color: #333;
  line-height: 1.5;
  word-break: break-all;
}

/* 评论输入框样式 */
.comment-input-mask {
  position: fixed;
  top: 0;
  left: 0;
  width: 100%;
  height: 100%;
  background-color: rgba(0, 0, 0, 0.5);
  z-index: 999;
}

.comment-input-box {
  position: fixed;
  bottom: 0;
  left: 0;
  width: 100%;
  background-color: #fff;
  z-index: 1000;
  padding: 20rpx;
  box-sizing: border-box;
  display: flex;
  align-items: flex-end;
  border-top-left-radius: 20rpx;
  border-top-right-radius: 20rpx;
  padding-bottom: calc(300rpx + env(safe-area-inset-bottom));
  box-shadow: 0 -4rpx 16rpx rgba(0,0,0,0.05);
}

.comment-textarea {
  flex: 1;
  background-color: #f5f5f5;
  border-radius: 12rpx;
  padding: 20rpx;
  font-size: 28rpx;
  height: 120rpx;
  margin-right: 20rpx;
}

.comment-send-btn {
  width: 120rpx;
  height: 70rpx;
  background: #3B7AD9;
  color: #fff;
  font-size: 28rpx;
  border-radius: 12rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  font-weight: bold;
}

/* 加载状态提示 */
.loading-status {
  text-align: center;
  padding: 20rpx 0 40rpx 0;
}

.loading-text {
  font-size: 24rpx;
  color: #999;
}

/* 返回顶部按钮 */
.back-to-top {
  position: fixed;
  right: 40rpx;
  bottom: 60rpx;
  width: 100rpx;
  height: 100rpx;
  background-color: #F5E6A0;
  border-radius: 50%;
  display: flex;
  align-items: center;
  justify-content: center;
  box-shadow: 0 4rpx 16rpx rgba(0,0,0,0.2);
  z-index: 99;
  transition: all 0.3s;
  opacity: 0.9;
}

.back-to-top:active {
  transform: scale(0.9);
  opacity: 1;
}

.back-to-top image {
  width: 44rpx;
  height: 44rpx;
}
/* 侧边悬浮菜单 */
.side-menu-container {
  position: fixed;
  right: 0;
  top: 25%;
  z-index: 999;
  display: flex;
  align-items: center;
  pointer-events: none; /* 让容器不阻挡点击，子元素单独开启 */
}

.side-menu-container view {
  pointer-events: auto; /* 子元素开启点击 */
}

/* 提示气泡 */
.menu-hint {
  background: rgba(0, 0, 0, 0.65);
  color: #fff;
  font-size: 22rpx;
  padding: 12rpx 16rpx;
  border-radius: 12rpx;
  margin-right: 12rpx;
  text-align: center;
  line-height: 1.3;
  position: relative;
  animation: float 2.5s ease-in-out infinite;
  box-shadow: 0 4rpx 12rpx rgba(0,0,0,0.1);
  backdrop-filter: blur(4px);
}

.menu-hint::after {
  content: '';
  position: absolute;
  right: -10rpx;
  top: 50%;
  transform: translateY(-50%);
  border-width: 10rpx 0 10rpx 10rpx;
  border-style: solid;
  border-color: transparent transparent transparent rgba(0, 0, 0, 0.65);
}

@keyframes float {
  0% { transform: translateX(0); }
  50% { transform: translateX(-8rpx); }
  100% { transform: translateX(0); }
}

/* 触发按钮 */
.menu-toggle {
  width: 64rpx;
  height: 96rpx;
  background: #F5E6A0;
  border-radius: 48rpx 0 0 48rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  box-shadow: -6rpx 4rpx 16rpx rgba(0,0,0,0.12);
  z-index: 1001;
  transition: all 0.3s cubic-bezier(0.25, 0.8, 0.25, 1);
}

.menu-toggle:active {
  transform: scale(0.95);
}

.side-menu-container.expanded .menu-toggle {
  background: #ffffff; /* 展开后变为白色，融入面板 */
  box-shadow: none;
  width: 50rpx; /* 稍微收窄 */
  border-right: 1rpx solid rgba(0,0,0,0.05); /* 微弱分割线 */
}

.toggle-icon {
  width: 32rpx;
  height: 32rpx;
  transition: transform 0.4s cubic-bezier(0.34, 1.56, 0.64, 1);
  opacity: 0.6;
  transform: rotate(180deg); /* 默认箭头向左 */
}

/* 兼容 WXML 中的 rotate 类，或者直接用 expanded 状态 */
.toggle-icon.rotate,
.side-menu-container.expanded .toggle-icon {
  transform: rotate(0deg);
  opacity: 0.4;
}

/* 菜单内容容器 */
.menu-content {
  width: 0;
  opacity: 0;
  overflow: hidden;
  transition: all 0.4s cubic-bezier(0.34, 1.56, 0.64, 1);
  display: flex;
  flex-direction: column;
  align-items: center;
  gap: 32rpx; /* 增加间距 */
  background: rgba(255, 255, 255, 0.95);
  border-top-left-radius: 32rpx;
  border-bottom-left-radius: 32rpx;
  box-shadow: -8rpx 8rpx 24rpx rgba(0,0,0,0.06);
  padding: 0;
  height: auto;
}

.side-menu-container.expanded .menu-content {
  width: 140rpx;
  opacity: 1;
  padding: 40rpx 0;
}

/* 菜单项基础 */
.menu-item {
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  opacity: 0;
  transform: translateX(30rpx);
  transition: all 0.4s ease;
}

.side-menu-container.expanded .menu-item {
  opacity: 1;
  transform: translateX(0);
}

.side-menu-container.expanded .menu-item:nth-child(1) { transition-delay: 0.05s; }
.side-menu-container.expanded .menu-item:nth-child(2) { transition-delay: 0.1s; }
.side-menu-container.expanded .menu-item:nth-child(3) { transition-delay: 0.15s; }

/* 圆形按钮 */
.menu-item.circle-btn {
  width: 96rpx;
  height: 96rpx;
  border-radius: 50%;
  box-shadow: 0 6rpx 16rpx rgba(0,0,0,0.08);
  position: relative;
  transition: transform 0.2s;
}

.menu-item.circle-btn:active {
  transform: scale(0.92);
}

/* 个人按钮 */
.menu-item.private-btn {
  background: linear-gradient(145deg, #ffffff, #f5f5f5);
  border: 1rpx solid #ebebeb;
}
.menu-item.private-btn image {
  width: 44rpx;
  height: 44rpx;
  margin-bottom: 6rpx;
  opacity: 0.8;
}

/* 好友按钮 */
.menu-item.friend-btn {
  background: #F5E6A0;
  border: none;
}
.menu-item.friend-btn image {
  width: 48rpx;
  height: 48rpx;
  margin-bottom: 4rpx;
  filter: brightness(0) invert(1); /* 白色图标 */
}

/* 发布按钮 */
.menu-item.publish-btn {
  background: linear-gradient(135deg, #F5E6A0, #FFD54F);
  border: none;
  box-shadow: 0 6rpx 20rpx rgba(255, 193, 7, 0.3); /* 稍微强一点的黄色阴影 */
}
.menu-item.publish-btn image {
  width: 52rpx;
  height: 52rpx;
  margin-bottom: 2rpx;
  filter: drop-shadow(0 2rpx 2rpx rgba(0,0,0,0.1));
}

.menu-label {
  font-size: 22rpx;
  font-weight: bold;
  color: #555;
  line-height: 1;
}

.menu-item.friend-btn .menu-label {
  color: #5d4037; /* 深棕色，在黄色背景上更清晰 */
}

.menu-item.publish-btn .menu-label {
  color: #5d4037;
}

/* 身份标签样式 */
.role-tag {
  font-size: 20rpx;
  padding: 2rpx 8rpx;
  border-radius: 6rpx;
  margin-left: 8rpx;
  font-weight: bold;
  line-height: 1.2;
}

.role-tag.admin {
  background-color: #ff4d4f;
  color: #fff;
}

.role-tag.developer {
  background-color: #ff4d4f;
  color: #fff;
}
